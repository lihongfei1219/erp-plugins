{
  "name": "erp-ocr-client",
  "version": "0.1.0",
  "private": true,
  "description": "Electron client for ERP receipt OCR assistance",
  "author": {
    "name": "lff",
    "email": "arui1219@163.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev",
    "test:qwen-ocr": "node scripts/test-qwen-ocr.mjs",
    "test:bailian-models": "node scripts/test-qwen-ocr.mjs",
    "test:qwen-ocr:prompt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-qwen-ocr.ps1",
    "test:bailian-models:prompt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-qwen-ocr.ps1",
    "test:ocr-recovery": "node --experimental-strip-types --test scripts/ocr-recovery.test.mjs",
    "test:incremental-extraction": "esbuild scripts/incremental-extraction.test.ts --bundle --platform=node --format=esm --outfile=tmp/incremental-extraction.test.mjs && node --test tmp/incremental-extraction.test.mjs",
    "test:business-isolation": "esbuild scripts/business-isolation.test.ts --bundle --platform=node --format=esm --outfile=tmp/business-isolation.test.mjs && node --test tmp/business-isolation.test.mjs",
    "test:accounts": "esbuild scripts/account-store.test.ts --bundle --platform=node --format=esm --outfile=tmp/account-store.test.mjs && node --test tmp/account-store.test.mjs",
    "test:multi-account": "node scripts/run-multi-account-test.mjs",
    "test:purchase-queue": "esbuild scripts/purchase-queue.test.ts --bundle --platform=node --format=esm --outfile=tmp/purchase-queue.test.mjs && node --test tmp/purchase-queue.test.mjs",
    "test:purchase-queue:electron": "node scripts/run-multi-account-test.mjs purchase-queue",
    "test:goods-receipt": "esbuild scripts/goods-receipt.test.ts --bundle --platform=node --format=esm --outfile=tmp/goods-receipt.test.mjs && node --test tmp/goods-receipt.test.mjs",
    "test:goods-receipt:document": "node scripts/test-goods-receipt-document.mjs",
    "test:document-images": "node --test scripts/document-images.test.mjs",
    "test:purchase-order": "esbuild scripts/purchase-order.test.ts --bundle --platform=node --format=esm --outfile=tmp/purchase-order.test.mjs && node --test tmp/purchase-order.test.mjs scripts/purchase-order-pipeline.test.mjs",
    "test:purchase-order:document": "node scripts/test-purchase-order-document.mjs",
    "test:performance": "esbuild scripts/performance.test.ts --bundle --packages=external --platform=node --format=esm --outfile=tmp/performance.test.mjs && node --test tmp/performance.test.mjs scripts/normalizer-thinking-ab.test.mjs",
    "test:normalizer-thinking": "node scripts/normalizer-thinking-ab.mjs",
    "test:normalizer-replay": "node scripts/normalizer-replay.mjs",
    "test:normalizer-replay:offline": "node --test scripts/normalizer-replay.test.mjs",
    "test:normalizer-config": "node --test scripts/normalizer-config.test.mjs",
    "test:page-pipeline": "esbuild scripts/model-request-scheduler.test.ts --bundle --platform=node --format=esm --outfile=tmp/model-request-scheduler.test.mjs && node --test tmp/model-request-scheduler.test.mjs scripts/page-pipeline.test.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@napi-rs/canvas": "1.0.8",
    "pdfjs-dist": "6.2.108",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.internal.erpocr",
    "productName": "ERP OCR 助手",
    "copyright": "Copyright © 2026 lff",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always"
    }
  }
}
